<mujoco model="simple_humanoid">
  <compiler angle="degree" coordinate="local"/>
  <option timestep="0.002" gravity="0 0 -9.81"/>

  <default>
    <joint damping="1.0" armature="0.01"/>
    <geom friction="1.0 0.005 0.0001" density="1000"/>
    <motor ctrlrange="-100 100"/>
  </default>

  <asset>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512"
             rgb1="0.1 0.1 0.1" rgb2="0.2 0.2 0.2"/>
    <material name="gridmat" texture="grid" texrepeat="8 8" reflectance="0.2"/>
  </asset>

  <worldbody>
    <light pos="0 0 4" dir="0 0 -1"/>
    <geom name="ground" type="plane" size="5 5 0.1" material="gridmat"/>

    <body name="torso" pos="0 0 1.4">
      <freejoint name="root"/>
      <geom name="torso_geom" type="capsule" fromto="0 0 -0.25 0 0 0.25" size="0.14" rgba="0.2 0.4 0.9 1"/>

      <body name="head" pos="0 0 0.45">
        <geom name="head_geom" type="sphere" size="0.13" rgba="0.9 0.7 0.5 1"/>
      </body>

      <body name="left_upper_leg" pos="0 0.11 -0.28">
        <joint name="left_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="left_upper_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.45" size="0.055" rgba="0.2 0.8 0.4 1"/>

        <body name="left_lower_leg" pos="0 0 -0.45">
          <joint name="left_knee" type="hinge" axis="0 1 0" range="-90 10"/>
          <geom name="left_lower_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.45" size="0.045" rgba="0.2 0.8 0.4 1"/>

          <body name="left_foot" pos="0.08 0 -0.48">
            <joint name="left_ankle" type="hinge" axis="0 1 0" range="-30 30"/>
            <geom name="left_foot_geom" type="box" size="0.16 0.055 0.035" rgba="0.1 0.9 0.3 1"/>
          </body>
        </body>
      </body>

      <body name="right_upper_leg" pos="0 -0.11 -0.28">
        <joint name="right_hip" type="hinge" axis="0 1 0" range="-45 45"/>
        <geom name="right_upper_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.45" size="0.055" rgba="0.9 0.3 0.3 1"/>

        <body name="right_lower_leg" pos="0 0 -0.45">
          <joint name="right_knee" type="hinge" axis="0 1 0" range="-90 10"/>
          <geom name="right_lower_leg_geom" type="capsule" fromto="0 0 0 0 0 -0.45" size="0.045" rgba="0.9 0.3 0.3 1"/>

          <body name="right_foot" pos="0.08 0 -0.48">
            <joint name="right_ankle" type="hinge" axis="0 1 0" range="-30 30"/>
            <geom name="right_foot_geom" type="box" size="0.16 0.055 0.035" rgba="0.9 0.2 0.2 1"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="left_hip_motor" joint="left_hip" gear="60"/>
    <motor name="left_knee_motor" joint="left_knee" gear="60"/>
    <motor name="left_ankle_motor" joint="left_ankle" gear="30"/>

    <motor name="right_hip_motor" joint="right_hip" gear="60"/>
    <motor name="right_knee_motor" joint="right_knee" gear="60"/>
    <motor name="right_ankle_motor" joint="right_ankle" gear="30"/>
  </actuator>
</mujoco>